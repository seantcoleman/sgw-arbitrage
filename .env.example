# ShopGoodwill credentials (single-tenant / scanner / env-fallback)
SGW_USERNAME=your_username
SGW_PASSWORD=your_password
# Or pre-encrypted (advanced):
# SGW_ENCRYPTED_USERNAME=
# SGW_ENCRYPTED_PASSWORD=

# eBay Developer credentials — https://developer.ebay.com
EBAY_APP_ID=YourApp-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EBAY_CERT_ID=YourCert-xxxx

# OpenAI API key — optional, used for GPT title cleaning
OPENAI_API_KEY=sk-...

# ── Multi-tenant (Supabase) ──────────────────────────────────────────────────
# DATABASE_URL=postgresql://postgres....supabase.com:5432/postgres
# SUPABASE_URL=https://xxxx.supabase.co   # JWKS verification for ES256 user tokens
# SUPABASE_JWT_SECRET=your-jwt-secret     # optional; only needed for legacy HS256 tokens
# CREDENTIAL_ENC_KEY=base64-32-byte-key   # Oracle VM only — never in Supabase
# AUTH_DISABLED=false                     # auto-true when URL and JWT secret are both missing
# DEV_USER_ID=00000000-0000-0000-0000-000000000001
# EXTERNAL_SCANNER=1                      # when sgw-scanner.service owns scans
# SNIPER_IN_API=0                         # when sgw-worker@ units own bidding

# Frontend (Vercel)
NEXT_PUBLIC_API_URL=/backend
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only rewrite target (named Cloudflare tunnel HTTPS URL preferred)
BACKEND_URL=https://api.yourdomain.com

# Stripe (Checkout + portal on Vercel; win-fee invoices on Oracle)
# STRIPE_SECRET_KEY=sk_live_... or rk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# NEXT_PUBLIC_APP_URL=https://sgw-arbitrage.vercel.app
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Vercel webhook/checkout profile updates

