# ShopGoodwill credentials
SGW_USERNAME=your_username
SGW_PASSWORD=your_password

# eBay Developer App ID — free at https://developer.ebay.com
EBAY_APP_ID=YourApp-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# OpenAI API key — optional, used for GPT title cleaning
# Without this, a regex fallback is used (less accurate)
OPENAI_API_KEY=sk-...

# Frontend API URL
# Local/Vercel: use same-origin proxy (/backend) — see frontend/next.config.ts
NEXT_PUBLIC_API_URL=/backend
# Server-only rewrite target (Oracle VM or local uvicorn)
BACKEND_URL=http://129.146.162.189:8000
